// ToDomain maps a slice of ent {{ $n.Name }} to {{ $pkgName }}.{{ $n.Name }}List.
func (es {{ $n.Name }}s) ToDomain() {{ $pkgName }}.{{ $n.Name }}List {
    ds := make({{ $pkgName }}.{{ $n.Name }}List, len(es))
    for i, e := range es {
        ds[i] = e.ToDomain()
    }
    return ds
}

{{- if not $ant.NoBulk }}
// CreateBulkDomain creates a {{ $n.Name }}CreateBulk from {{ $pkgName }}.{{ $n.Name }}List.
//
// If any per-row transformer returns an error, the first such error is
// returned immediately and partial bulk is discarded.
func (c *{{ $n.Name }}Client) CreateBulkDomain(ctx context.Context, ds {{ $pkgName }}.{{ $n.Name }}List, opts ...entdomain.ApplyOption) (*{{ $n.Name }}CreateBulk, error) {
    builders := make([]*{{ $n.Name }}Create, len(ds))
    for i := range ds {
        b, err := c.Create().ApplyDomain(ctx, ds[i], opts...)
        if err != nil {
            return nil, err
        }
        builders[i] = b
    }
    return c.CreateBulk(builders...), nil
}

