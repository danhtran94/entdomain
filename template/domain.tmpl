func (c *{{ $n.Name }}Client) CreateBulkDomainX(ctx context.Context, ds {{ $pkgName }}.{{ $n.Name }}List, opts ...entdomain.ApplyOption) *{{ $n.Name }}CreateBulk {
    b, err := c.CreateBulkDomain(ctx, ds, opts...)
    if err != nil {
        panic(err)
    }
    return b
}

// {{ $n.Name }}UpdateOneBulk holds a set of {{ $n.Name }}UpdateOne builders.
type {{ $n.Name }}UpdateOneBulk struct {
    builders []*{{ $n.Name }}UpdateOne
}

// Save executes all builders and returns the updated entities as {{ $pkgName }}.{{ $n.Name }}List.
func (b *{{ $n.Name }}UpdateOneBulk) Save(ctx context.Context) ({{ $pkgName }}.{{ $n.Name }}List, error) {
    result := make({{ $pkgName }}.{{ $n.Name }}List, 0, len(b.builders))
    for _, builder := range b.builders {
        updated, err := builder.Save(ctx)
        if err != nil {
            return nil, err
        }
        result = append(result, updated.ToDomain())
    }
    return result, nil
}

// SaveX is like Save but panics on error.
func (b *{{ $n.Name }}UpdateOneBulk) SaveX(ctx context.Context) {{ $pkgName }}.{{ $n.Name }}List {
    result, err := b.Save(ctx)
    if err != nil {
        panic(err)
    }
    return result
